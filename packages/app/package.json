{
  "name": "@learning-agent/app",
  "version": "0.0.1",
  "private": true,
  "description": "Learning workbench bundle: every learning unit, the tutor and side-chat presets, and DSH's own UI switched off",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@learning-agent/assess": "workspace:*",
    "@learning-agent/core": "workspace:*",
    "@learning-agent/curriculum": "workspace:*",
    "@learning-agent/goal": "workspace:*",
    "@learning-agent/knowledge": "workspace:*",
    "@learning-agent/learner": "workspace:*",
    "@learning-agent/library": "workspace:*",
    "@learning-agent/planner": "workspace:*",
    "@learning-agent/settings": "workspace:*",
    "@learning-agent/shell": "workspace:*",
    "@learning-agent/sidechat": "workspace:*",
    "@learning-agent/textbook": "workspace:*",
    "@learning-agent/tutor": "workspace:*"
  }
}
