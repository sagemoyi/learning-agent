      "inject": [
        "@learning-agent/shell"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@learning-agent/contracts": "workspace:*",
    "@learning-agent/kit": "workspace:*",
    "fflate": "^0.8.3",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  }
}
