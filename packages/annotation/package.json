{
  "name": "@learning-agent/annotation",
  "version": "0.0.1",
  "private": true,
  "description": "annotation unit: notes on textbook paragraphs and sources (question, my understanding, highlight, error), kept findable when the text changes; questions open side chats, errors become proposals",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "client": {
      "inject": [
        "@learning-agent/shell",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@learning-agent/contracts": "workspace:*",
    "@learning-agent/kit": "workspace:*",
    "lucide-react": "^1.50.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
