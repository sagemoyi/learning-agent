{
  "name": "@learning-agent/sidechat",
  "version": "0.0.1",
  "private": true,
  "description": "sidechat unit: side chat bound to the page selection, isolated from the teacher; summary into notes and evidence; right sidebar",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./tools/locale/*": "./locale/tools/*"
  },
  "dsh": {
    "client": {
      "inject": [
        "@learning-agent/shell",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@learning-agent/contracts": "workspace:*",
    "@learning-agent/kit": "workspace:*",
    "lucide-react": "^1.50.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
