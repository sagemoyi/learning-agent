{
  "name": "learning-agent",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Personal learning workbench built as DSH (cordis) plugins",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dist": "node scripts/pack.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/e2e/run.ts smoke",
    "e2e": "node scripts/e2e/run.ts",
    "backup": "node --disable-warning=ExperimentalWarning packages/core/lib/cli.js backup",
    "restore": "node --disable-warning=ExperimentalWarning packages/core/lib/cli.js restore",
    "mineru:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mineru-server.ps1"
  },
  "devDependencies": {
    "@learning-agent/contracts": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "^0.25.0",
    "gifenc": "^1.0.3",
    "jsdom": "^30.1.3",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
